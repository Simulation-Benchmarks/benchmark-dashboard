
FROM python:3.12.15-alpine3.24

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Apply the latest security updates available from Alpine repositories.
RUN apk upgrade --no-cache

COPY requirements.txt .

# Install dependencies and remove the build toolchain afterward.
RUN apk add --no-cache --virtual .build-deps \
        build-base \
        musl-dev \
        libffi-dev \
        git \
    && python -m pip install --no-cache-dir --upgrade pip==26.2.2 \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip uninstall -y pip \
    && apk del .build-deps

COPY --chown=10001:10001 app/ app/

USER 10001:10001

EXPOSE 9000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9000"]
